# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - AGILIX COMPANY PROFILE
# Copy this file to .env.local and update the values with your credentials.
# ==============================================================================

# 1. Website Domain URL (Used for SEO, dynamic Sitemap, and Robots.txt)
NEXT_PUBLIC_SITE_URL=https://agilix.id

# 2. EmailJS Credentials (Used for Contact Form in /contact)
# Register and configure service & template at https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# 3. WhatsApp Integration (WhatsApp number for floating button, e.g., 0895324435347 or 62895324435347)
NEXT_PUBLIC_WHATSAPP_NUMBER=your_whatsapp_number_here
